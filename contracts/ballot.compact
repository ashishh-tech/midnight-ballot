// ============================================================================
// Midnight Ballot — Privacy-Preserving Voting Contract
// ============================================================================
//
// This Compact smart contract demonstrates Midnight's dual-state architecture:
//
//   • PUBLIC LEDGER  — on-chain state visible to everyone (vote tally)
//   • PRIVATE WITNESS — off-chain data that NEVER leaves the voter's machine
//   • disclose()     — the explicit boundary between private and public
//
// How it works:
//   1. An admin opens voting on a topic
//   2. Voters call castVote() — their identity and vote choice are PRIVATE
//      (held as witness data), but the aggregate count is PUBLIC (on the ledger)
//   3. The ZK proof guarantees the count is correct without revealing who voted
//   4. Optionally, a voter can call revealMyChoice() to VOLUNTARILY disclose
//      their vote — demonstrating deliberate use of disclose()
//
// ============================================================================

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// SECTION 1: PUBLIC LEDGER STATE
// ---------------------------------------------------------------------------
// Everything declared with `export ledger` is stored on-chain and publicly
// visible to all network participants. This is the "transparent" half of
// Midnight's dual-state model.
// ---------------------------------------------------------------------------

// Total number of "yes" votes — publicly visible to everyone.
export ledger yesVotes: Counter;

// Total number of "no" votes — also publicly visible.
export ledger noVotes: Counter;

// The topic being voted on — stored as a 32-byte hash on-chain.
export ledger topicHash: Bytes<32>;

// Whether voting is currently open (true) or closed (false).
export ledger isOpen: Boolean;


// ---------------------------------------------------------------------------
// SECTION 2: PRIVATE WITNESSES
// ---------------------------------------------------------------------------
// Witnesses are private, off-chain callback functions. They return data that
// lives ONLY on the voter's local machine.
// ---------------------------------------------------------------------------

// Returns a secret identifier for the voter (e.g., derived from their wallet).
// This is NEVER sent to the blockchain — it stays on the voter's device.
witness getVoterSecret(): Bytes<32>;

// Returns the voter's private choice: 1 = Yes, 0 = No.
witness getVoteChoice(): Uint<32>;


// ---------------------------------------------------------------------------
// SECTION 3: CIRCUITS (ZK-Proven Logic)
// ---------------------------------------------------------------------------

/// Opens voting for a given topic. Sets the topic hash and enables voting.
export circuit openVoting(topic: Bytes<32>): [] {
  assert(!isOpen, "Voting is already open");

  // We explicitly disclose the topic parameter to store it on the public ledger
  topicHash = disclose(topic);
  isOpen = true;
}

/// Casts a vote. The voter's identity remains completely PRIVATE.
/// The ZK proof guarantees the voter made a valid choice (0 or 1) and that 
/// the correct counter was incremented, without revealing WHO voted.
export circuit castVote(): [] {
  assert(isOpen, "Voting is not open");

  // --- PRIVATE ZONE ---
  const _secret = getVoterSecret();   // Voter's private identifier (remains hidden!)
  const choice  = getVoteChoice();    // Voter's private choice (0 or 1)

  assert(choice == 0 || choice == 1, "Vote must be 0 (No) or 1 (Yes)");

  // --- PUBLIC ZONE ---
  // To update public counters based on a choice, the choice itself must be 
  // disclosed in this specific design. (The voter's identity remains private).
  const publicChoice = disclose(choice);

  if (publicChoice == 1) {
    yesVotes.increment(1);
  } else {
    noVotes.increment(1);
  }
}

/// Closes voting. After this, no more votes can be cast.
export circuit closeVoting(): [] {
  assert(isOpen, "Voting is not open");
  isOpen = false;
}
