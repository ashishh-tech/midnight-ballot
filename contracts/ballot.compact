// ============================================================================
// Midnight Ballot — Privacy-Preserving Anonymous Voting Contract
// ============================================================================
//
// Dual-State Zero-Knowledge Architecture with Nullifier Double-Voting Prevention:
//
//   • PUBLIC LEDGER  — vote tally, spent nullifier set, topic hash, quorum
//   • PRIVATE WITNESS — voter secret, choice, nullifier, eligibility proof (off-chain)
//   • disclose()     — explicit boundary between private witness and public ledger
//
// Key Features:
//   1. Nullifier Double Voting Prevention: Each voter generates a unique
//      ZK nullifier per proposal. Spent nullifiers are stored on-chain to
//      block duplicate votes without revealing voter identity.
//   2. Private Voter Eligibility Verification: Voters present witness proofs
//      verified against the active proposal's voter group commitment root.
//   3. Configurable Quorum & Rules: Enforcement of minimum voting thresholds.
//
// ============================================================================

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// SECTION 1: PUBLIC LEDGER STATE
// ---------------------------------------------------------------------------

// Total number of "yes" votes — publicly visible.
export ledger yesVotes: Counter;

// Total number of "no" votes — publicly visible.
export ledger noVotes: Counter;

// The topic being voted on — 32-byte hash.
export ledger topicHash: Bytes<32>;

// Minimum required total votes (quorum threshold).
export ledger minimumQuorum: Uint<32>;

// Voter group eligibility Merkle root / commitment.
export ledger voterGroupMerkleRoot: Bytes<32>;

// Whether voting is currently open.
export ledger isOpen: Boolean;

// Set of spent nullifiers to prevent double-voting anonymously.
export ledger nullifiers: Set<Bytes<32>>;


// ---------------------------------------------------------------------------
// SECTION 2: PRIVATE WITNESSES (Off-Chain Client Data)
// ---------------------------------------------------------------------------

// Secret identifier for the voter — stays on voter's machine.
witness getVoterSecret(): Bytes<32>;

// Voter's choice: 1 = Yes, 0 = No.
witness getVoteChoice(): Uint<32>;

// Deterministic ZK nullifier computed from (voterSecret, topicHash).
witness getNullifier(topic: Bytes<32>): Bytes<32>;

// Proof of voter membership in the authorized voter group.
witness getEligibilityProof(): Bytes<32>;


// ---------------------------------------------------------------------------
// SECTION 3: CIRCUITS (ZK-Proven Logic)
// ---------------------------------------------------------------------------

/// Opens voting for a topic with specified quorum requirement and voter group root.
export circuit openVoting(topic: Bytes<32>, quorum: Uint<32>, groupRoot: Bytes<32>): [] {
  assert(!isOpen, "Voting is already open");

  topicHash = disclose(topic);
  minimumQuorum = disclose(quorum);
  voterGroupMerkleRoot = disclose(groupRoot);
  isOpen = true;
}

/// Casts a vote anonymously using ZK proofs while enforcing nullifier uniqueness.
export circuit castVote(): [] {
  assert(isOpen, "Voting is not open");

  // --- PRIVATE WITNESS ZONE ---
  const _secret = getVoterSecret();
  const choice = getVoteChoice();
  const nullifier = getNullifier(topicHash);
  const eligibility = getEligibilityProof();

  assert(choice == 0 || choice == 1, "Vote must be 0 (No) or 1 (Yes)");
  assert(eligibility != pad(32, ""), "Invalid voter eligibility proof");

  // --- PUBLIC DISCLOSURE BOUNDARY ---
  const publicChoice = disclose(choice);
  const publicNullifier = disclose(nullifier);

  // Enforce nullifier uniqueness to prevent double voting
  assert(!nullifiers.member(publicNullifier), "Vote already cast with this nullifier");
  nullifiers.insert(publicNullifier);

  if (publicChoice == 1) {
    yesVotes.increment(1);
  } else {
    noVotes.increment(1);
  }
}

/// Closes voting and verifies minimum quorum rule.
export circuit closeVoting(): [] {
  assert(isOpen, "Voting is not open");
  assert(yesVotes.read() + noVotes.read() >= minimumQuorum, "Minimum voting quorum not reached");
  isOpen = false;
}
