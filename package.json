    "@midnight-ntwrk/compact-runtime": "^0.31.0",
    "@midnight-ntwrk/midnight-js-contracts": "^0.31.0",
    "@midnight-ntwrk/midnight-js-network-id": "^0.31.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.0"
  }
