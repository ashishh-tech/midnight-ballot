{
  "name": "midnight-ballot",
  "version": "1.0.0",
  "description": "Privacy-preserving anonymous voting contract on Midnight blockchain — private vote, public disclosed count",
  "type": "module",
  "scripts": {
    "compact": "~/.local/bin/compact compile contracts/ballot.compact managed/",
    "build": "npm run compact && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node dist/scripts/deploy.js",
    "clean": "rimraf managed/ dist/"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "compact",
    "zero-knowledge",
    "voting",
    "privacy"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "latest",
    "@midnight-ntwrk/midnight-js-contracts": "latest",
    "@midnight-ntwrk/midnight-js-network-id": "latest",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@meshsdk/midnight-setup": "^1.9.0-beta.98",
    "@midnight-ntwrk/midnight-js": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/wallet": "^5.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "bip39": "^3.1.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2"
  }
}
